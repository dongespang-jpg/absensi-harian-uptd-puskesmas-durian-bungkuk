<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Absensi Pustu dan Poskesdes UPTD Puskesmas Durian Bungkuk</title>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      font-family: 'Roboto', sans-serif;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      /* Background gambar kebun karet dengan overlay gelap agar teks tetap jelas */
      background:
        linear-gradient(rgba(0, 55, 45, 0.72), rgba(0, 40, 32, 0.82)),
        url('data:image/jpeg;base64,')
        no-repeat center center fixed;
      background-size: cover;
    }

    .card {
      width: 100%;
      max-width: 440px;
      background: rgba(255, 255, 255, 0.96);
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
      animation: fadeIn 0.4s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .header {
      text-align: center;
      margin-bottom: 20px;
    }

    .badge {
      display: inline-block;
      background: #00695C;
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      padding: 4px 12px;
      border-radius: 20px;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
    }

    .header h1 {
      font-size: 18px;
      color: #004D40;
      margin: 4px 0;
      line-height: 1.35;
    }

    .header p {
      font-size: 13px;
      color: #546E7A;
      margin: 0;
    }

    label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: #263238;
      margin-bottom: 6px;
    }

    input[type="text"] {
      width: 100%;
      padding: 12px 14px;
      border: 1.5px solid #CFD8DC;
      border-radius: 10px;
      font-size: 14px;
      outline: none;
      transition: border-color 0.2s;
    }

    input[type="text"]:focus {
      border-color: #00695C;
    }

    .btn {
      width: 100%;
      padding: 13px;
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.1s, opacity 0.2s;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn-primary {
      background: #00695C;
      color: #fff;
      margin-top: 14px;
    }

    .btn-secondary {
      background: #ECEFF1;
      color: #37474F;
      font-size: 13px;
      padding: 9px;
      margin-top: 10px;
    }

    .jenis-group {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 16px;
    }

    .jenis-btn {
      padding: 12px;
      border: 2px solid #CFD8DC;
      border-radius: 10px;
      background: #fff;
      font-weight: 700;
      font-size: 14px;
      color: #455A64;
      cursor: pointer;
      transition: all 0.2s;
    }

    .jenis-btn.active-masuk {
      background: #E8F5E9;
      border-color: #2E7D32;
      color: #1B5E20;
    }

    .jenis-btn.active-pulang {
      background: #FFEBEE;
      border-color: #C62828;
      color: #B71C1C;
    }

    .map-box {
      width: 100%;
      height: 170px;
      border-radius: 10px;
      overflow: hidden;
      border: 1.5px solid #CFD8DC;
      background: #ECEFF1;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      color: #607D8B;
    }

    .map-box iframe {
      width: 100%;
      height: 100%;
      border: 0;
    }

    .coord-text {
      font-size: 12px;
      color: #455A64;
      margin-bottom: 14px;
    }

    .camera-box {
      border: 1.5px dashed #90A4AE;
      border-radius: 10px;
      padding: 12px;
      text-align: center;
      margin-bottom: 16px;
      background: #FAFAFA;
    }

    .camera-label {
      display: inline-block;
      background: #00796B;
      color: #fff;
      padding: 10px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
    }

    #fotoInput {
      display: none;
    }

    #previewImg {
      display: none;
      width: 100%;
      max-height: 200px;
      object-fit: cover;
      border-radius: 8px;
      margin-top: 10px;
    }

    .status-msg {
      margin-top: 12px;
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 13px;
      display: none;
      text-align: center;
    }

    .status-success {
      background: #E8F5E9;
      color: #1B5E20;
      border: 1px solid #A5D6A7;
    }

    .status-error {
      background: #FFEBEE;
      color: #B71C1C;
      border: 1px solid #EF9A9A;
    }

    .hidden {
      display: none;
    }
  </style>
</head>
<body>

  <!-- HALAMAN LOGIN INTERAKTIF TANPA PASSWORD -->
  <div id="loginPage" class="card">
    <div class="header">
      <span class="badge">UPTD PUSKESMAS DURIAN BUNGKUK</span>
      <h1>Absensi Pustu dan Poskesdes</h1>
      <p>Silakan masukkan nama Anda untuk masuk ke aplikasi</p>
    </div>

    <label for="loginNama">Nama Pegawai</label>
    <input type="text" id="loginNama" placeholder="Contoh: MASLIANI" autocomplete="name">

    <button class="btn btn-primary" onclick="masukAplikasi()">Masuk Aplikasi</button>
    <div id="loginError" class="status-msg status-error"></div>
  </div>

  <!-- HALAMAN UTAMA ABSENSI -->
  <div id="absensiPage" class="card hidden">
    <div class="header">
      <span class="badge">UPTD PUSKESMAS DURIAN BUNGKUK</span>
      <h1>Absensi Pustu dan Poskesdes</h1>
      <p>Halo, <strong id="displayNama"></strong></p>
    </div>

    <label>Jenis Absen</label>
    <div class="jenis-group">
      <button type="button" id="btnMasuk" class="jenis-btn active-masuk" onclick="pilihJenis('Masuk')">Masuk</button>
      <button type="button" id="btnPulang" class="jenis-btn" onclick="pilihJenis('Pulang')">Pulang</button>
    </div>

    <label>Lokasi Perangkat (Google Maps)</label>
    <div class="map-box" id="mapContainer">
      Mendeteksi lokasi GPS perangkat...
    </div>
    <div class="coord-text" id="coordText">Koordinat: menunggu izin GPS...</div>

    <label>Ambil Foto Kamera</label>
    <div class="camera-box">
      <label for="fotoInput" class="camera-label">📷 Buka Kamera Perangkat</label>
      <input type="file" id="fotoInput" accept="image/*" capture="user" onchange="prosesFoto(event)">
      <img id="previewImg" alt="Preview Foto Absensi">
    </div>

    <button id="btnKirim" class="btn btn-primary" onclick="kirimAbsensi()">Kirim Absensi</button>
    <button class="btn btn-secondary" onclick="keluarAplikasi()">Ganti Nama / Keluar</button>

    <div id="statusMsg" class="status-msg"></div>
  </div>

  <script>
    let namaUser = '';
    let jenisAbsen = 'Masuk';
    let currentLat = null;
    let currentLng = null;
    let fotoBase64 = '';

    // Login otomatis tanpa password
    function masukAplikasi() {
      const input = document.getElementById('loginNama').value.trim();
      const errBox = document.getElementById('loginError');

      if (!input) {
        errBox.textContent = 'Harap isi nama Anda terlebih dahulu.';
        errBox.style.display = 'block';
        return;
      }

      errBox.style.display = 'none';
      namaUser = input;
      document.getElementById('displayNama').textContent = namaUser;

      document.getElementById('loginPage').classList.add('hidden');
      document.getElementById('absensiPage').classList.remove('hidden');

      ambilLokasiGPS();
    }

    function keluarAplikasi() {
      document.getElementById('absensiPage').classList.add('hidden');
      document.getElementById('loginPage').classList.remove('hidden');
      document.getElementById('statusMsg').style.display = 'none';
    }

    function pilihJenis(jenis) {
      jenisAbsen = jenis;
      const btnMasuk = document.getElementById('btnMasuk');
      const btnPulang = document.getElementById('btnPulang');

      btnMasuk.className = 'jenis-btn' + (jenis === 'Masuk' ? ' active-masuk' : '');
      btnPulang.className = 'jenis-btn' + (jenis === 'Pulang' ? ' active-pulang' : '');
    }

    function ambilLokasiGPS() {
      const mapBox = document.getElementById('mapContainer');
      const coordText = document.getElementById('coordText');

      if (!navigator.geolocation) {
        mapBox.textContent = 'Browser tidak mendukung GPS.';
        return;
      }

      navigator.geolocation.getCurrentPosition(
        function(pos) {
          currentLat = pos.coords.latitude.toFixed(6);
          currentLng = pos.coords.longitude.toFixed(6);

          coordText.textContent = 'Koordinat: ' + currentLat + ', ' + currentLng;
          // Tampilan Google Maps kecil tanpa API Key
          const embedUrl = 'https://maps.google.com/maps?q=' + currentLat + ',' + currentLng + '&hl=id&z=16&output=embed';
          mapBox.innerHTML = '<iframe src="' + embedUrl + '" loading="lazy"></iframe>';
        },
        function(err) {
          mapBox.textContent = 'Gagal mengakses GPS. Pastikan izin lokasi aktif.';
          coordText.textContent = 'Error GPS: ' + err.message;
        },
        { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
      );
    }

    // Kompresi foto ringan dari kamera sebelum dikirim ke Apps Script
    function prosesFoto(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          const canvas = document.createElement('canvas');
          const maxW = 800;
          const scale = Math.min(1, maxW / img.width);
          canvas.width = img.width * scale;
          canvas.height = img.height * scale;

          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

          fotoBase64 = canvas.toDataURL('image/jpeg', 0.75);
          const preview = document.getElementById('previewImg');
          preview.src = fotoBase64;
          preview.style.display = 'block';
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function kirimAbsensi() {
      const statusMsg = document.getElementById('statusMsg');
      const btnKirim = document.getElementById('btnKirim');

      if (!currentLat || !currentLng) {
        tampilkanStatus('Lokasi GPS belum terdeteksi. Aktifkan lokasi perangkat Anda.', false);
        return;
      }
      if (!fotoBase64) {
        tampilkanStatus('Harap ambil foto terlebih dahulu menggunakan kamera.', false);
        return;
      }

      btnKirim.disabled = true;
      btnKirim.textContent = 'Mengirim data...';
      statusMsg.style.display = 'none';

      const payload = {
        nama: namaUser,
        jenis: jenisAbsen,
        lat: currentLat,
        lng: currentLng,
        fotoBase64: fotoBase64
      };

      google.script.run
        .withSuccessHandler(function(res) {
          btnKirim.disabled = false;
          btnKirim.textContent = 'Kirim Absensi';
          if (res.status === 'success') {
            tampilkanStatus(res.message, true);
            fotoBase64 = '';
            document.getElementById('previewImg').style.display = 'none';
            document.getElementById('fotoInput').value = '';
          } else {
            tampilkanStatus(res.message, false);
          }
        })
        .withFailureHandler(function(err) {
          btnKirim.disabled = false;
          btnKirim.textContent = 'Kirim Absensi';
          tampilkanStatus('Terjadi kesalahan: ' + err.message, false);
        })
        .simpanAbsensi(payload);
    }

    function tampilkanStatus(pesan, sukses) {
      const el = document.getElementById('statusMsg');
      el.textContent = pesan;
      el.className = 'status-msg ' + (sukses ? 'status-success' : 'status-error');
      el.style.display = 'block';
    }
  </script>
</body>
</html>
